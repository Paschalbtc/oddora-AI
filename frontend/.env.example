# ==============================================================================
# ODDORA AI - VERCEL & LOCAL ENVIRONMENT VARIABLES
# ==============================================================================
# Copy these directly into Vercel Project Settings > Environment Variables:

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI & Football Providers
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
API_FOOTBALL_KEY=your_api_football_key

# Leave empty on Vercel so the frontend routes calls to same-origin /api/...
NEXT_PUBLIC_API_URL=
